# Instrumented-design synthesis (3sensor, 15nm, counted) -- generated by sensor_injector.py
# Run AFTER inject_sensors.tcl (needs the Tessent TSDB in this config's tsdb_outdir).

set synthetic_library /home/b.mansour/Desktop/klessydra_git/DSP_BreakDown_test_ijtag/synthesis/15nm/CCS/NanGate_15nm_OCL_typical_conditional_ccs.db
set target_library    /home/b.mansour/Desktop/klessydra_git/DSP_BreakDown_test_ijtag/synthesis/15nm/CCS/NanGate_15nm_OCL_typical_conditional_ccs.db
set link_library [list $target_library $synthetic_library]

set hdlin_vhdl_2008 true

read_vhdl /home/b.mansour/Desktop/klessydra_git/DSP_BreakDown_test_ijtag/packages/PKG_tb_config.vhd
read_vhdl /home/b.mansour/Desktop/klessydra_git/DSP_BreakDown_test_ijtag/packages/PKG_RiscV_Klessydra.vhd

# Sensor RTL read so its internal area is synthesised and counted.
analyze -format vhdl /home/b.mansour/Desktop/klessydra_git/ijtag-sensor-tool/sensors/activity_sensor.vhd

set rewritten_dir /home/b.mansour/Desktop/klessydra_git/DSP_BreakDown_test_ijtag/modules/out/3sensor/tsdb_outdir/dft_inserted_designs/RTL_DSP_TOP_rtl1_3sensor.dft_inserted_design/modified_rtl_files
set rewritten_files [glob -nocomplain $rewritten_dir/*.vhd]
if {[llength $rewritten_files] == 0} {
    echo "ERROR: no Tessent-rewritten RTL found -- run inject_sensors.tcl first."
    exit 1
}
set exclude {}
foreach f $rewritten_files { lappend exclude [file tail $f] }

set modified_dir /home/b.mansour/Desktop/klessydra_git/DSP_BreakDown_test_ijtag/modules/out/3sensor/modified
foreach f [lsort [glob -nocomplain $modified_dir/*.vhd]] {
    set base [file tail $f]
    if {[lsearch -exact $exclude $base] >= 0} continue
    if {$base eq "modified_RTL_DSP_TOP.vhd"} continue
    analyze -format vhdl $f
}

# Tessent-rewritten (instrumented) modules.
foreach f [lsort $rewritten_files] { analyze -format vhdl $f }

set sib_dir /home/b.mansour/Desktop/klessydra_git/DSP_BreakDown_test_ijtag/modules/out/3sensor/tsdb_outdir/instruments/RTL_DSP_TOP_rtl1_3sensor_ijtag.instrument
foreach f [glob -nocomplain $sib_dir/*.v] { analyze -format verilog $f }

set THREAD_POOL_SIZE 3
set accl_en 1
set replicate_accl_en 1
set multithreaded_accl_en 0
set SPM_NUM 4
set Addr_Width 14
set SIMD 2
set TPS_CEIL 2
set TPS_BUF_CEIL 1
set SPM_ADDR_WID 3
set SIMD_BITS 1
set Data_Width 32
set SIMD_Width 64
set ACCL_NUM 3
set FU_NUM 3

elaborate RTL_DSP_TOP -parameters "THREAD_POOL_SIZE=$THREAD_POOL_SIZE, accl_en=$accl_en, replicate_accl_en=$replicate_accl_en, multithreaded_accl_en=$multithreaded_accl_en, SPM_NUM=$SPM_NUM, Addr_Width=$Addr_Width, SIMD=$SIMD, TPS_CEIL=$TPS_CEIL, TPS_BUF_CEIL=$TPS_BUF_CEIL, SPM_ADDR_WID=$SPM_ADDR_WID, SIMD_BITS=$SIMD_BITS, Data_Width=$Data_Width, SIMD_Width=$SIMD_Width, ACCL_NUM=$ACCL_NUM, FU_NUM=$FU_NUM"

link
check_design

set _sd [get_designs -quiet "activity_sensor*"]
if {[sizeof_collection $_sd] > 0} {
    set_dont_touch $_sd
} else {
    echo "WARNING: no activity_sensor* design found to set_dont_touch"
}

create_clock -name clk_i -period 2000 clk_i

compile

file mkdir /home/b.mansour/Desktop/klessydra_git/DSP_BreakDown_test_ijtag/modules/out/3sensor/synthesis_reports_3sensor_15nm_counted
write -f verilog -hierarchy -output /home/b.mansour/Desktop/klessydra_git/DSP_BreakDown_test_ijtag/modules/out/3sensor/RTL_DSP_TOP_instrumented_3sensor_15nm_counted.v

report_area      -nosplit -hierarchy > /home/b.mansour/Desktop/klessydra_git/DSP_BreakDown_test_ijtag/modules/out/3sensor/synthesis_reports_3sensor_15nm_counted/report_area.txt
report_power     -nosplit -hierarchy > /home/b.mansour/Desktop/klessydra_git/DSP_BreakDown_test_ijtag/modules/out/3sensor/synthesis_reports_3sensor_15nm_counted/report_power.txt
report_reference -nosplit -hierarchy > /home/b.mansour/Desktop/klessydra_git/DSP_BreakDown_test_ijtag/modules/out/3sensor/synthesis_reports_3sensor_15nm_counted/report_references.txt
report_cell                          > /home/b.mansour/Desktop/klessydra_git/DSP_BreakDown_test_ijtag/modules/out/3sensor/synthesis_reports_3sensor_15nm_counted/report_cells.txt

exit
